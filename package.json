{
  "name": "shopify-store-sync-mcp",
  "version": "0.2.1",
  "description": "MCP server and CLI to diff and sync configuration between Shopify stores: metafield and metaobject definitions, metaobjects, collections, pages, menus, redirects, policies, metafield values and translations. Config as code, dry-run plans, never deletes.",
  "type": "module",
  "bin": {
    "shopify-store-sync-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "validate:graphql": "node scripts/validate-graphql.mjs",
    "docs:demo": "tsx scripts/demo-data.ts > docs/demo-output.json",
    "docs:images": "node scripts/render-docs-images.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shopify",
    "shopify-plus",
    "metafields",
    "metaobjects",
    "store-sync",
    "diff",
    "claude",
    "ai-agents",
    "translations",
    "config-as-code",
    "cli"
  ],
  "author": "Youssef Idder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ussefidder/shopify-store-sync-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ussefidder/shopify-store-sync-mcp/issues"
  },
  "homepage": "https://github.com/ussefidder/shopify-store-sync-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "graphql": "^16.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
