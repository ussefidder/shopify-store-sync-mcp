{
  "name": "shopify-store-sync-mcp",
  "version": "0.5.2",
  "mcpName": "io.github.ussefidder/shopify-store-sync-mcp",
  "description": "MCP server and CLI to diff and sync configuration between Shopify stores: products, collections, pages, menus, redirects, policies, metafield and metaobject definitions, metaobjects, metafield values and translations. Config as code, dry-run plans, never deletes.",
  "type": "module",
  "bin": {
    "shopify-store-sync-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "validate:graphql": "node scripts/validate-graphql.mjs",
    "docs:demo": "tsx scripts/demo-data.ts > docs/demo-output.json",
    "docs:images": "node scripts/render-docs-images.mjs",
    "lint": "eslint .",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate:graphql",
    "docs:video": "node docs/video/render.mjs docs/video/build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shopify",
    "shopify-plus",
    "products",
    "metafields",
    "metaobjects",
    "store-sync",
    "diff",
    "claude",
    "ai-agents",
    "translations",
    "config-as-code",
    "cli"
  ],
  "author": "Youssef Idder",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ussefidder/shopify-store-sync-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ussefidder/shopify-store-sync-mcp/issues"
  },
  "homepage": "https://github.com/ussefidder/shopify-store-sync-mcp#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "graphql": "^16.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
