{
  "stores": {
    "dev": {
      "domain": "my-brand-dev.myshopify.com",
      "auth": "shopify-cli",
      "label": "Development store (signed in with: shopify-store-sync-mcp connect dev)"
    },
    "staging": {
      "domain": "my-brand-staging.myshopify.com",
      "auth": "shopify-cli",
      "allowWrites": true
    },
    "eu": {
      "domain": "my-brand-eu.myshopify.com",
      "clientId": "env:EU_CLIENT_ID",
      "clientSecret": "env:EU_CLIENT_SECRET",
      "allowWrites": true,
      "protected": true,
      "label": "EU production (Dev Dashboard app; a person confirms every apply)"
    },
    "legacy": {
      "domain": "my-brand-uk.myshopify.com",
      "accessToken": "env:UK_TOKEN",
      "label": "Existing custom app token (read-only here)"
    }
  }
}
